# Staging checklist (npm run checklist:staging). Copy to .env.checklist,
# which git ignores, and fill in. Never commit real values. Variables already
# set in the shell win over this file (the staging smoke test uses the same
# PT_STAGING_* names), so unset them first.

# The Medusa store under test, with the plugin installed.
STORE_URL=https://medusa-staging.example.com
# Stores the checklist must never reach, comma-separated (a store in daily
# use on this machine, say). Required: the checklist refuses to run while it
# is unset. Set it empty to forbid none. A local one forbids its port on every
# local spelling of the host.
# CHECKLIST_FORBIDDEN_STORE_URLS=http://localhost:9000
STORE_ADMIN_EMAIL=
STORE_ADMIN_PASSWORD=
# A publishable key for a sales channel that sells the products below.
STORE_PUBLISHABLE_KEY=

# The Print Trail API the store's plugin uses: https under consilstaging.com.
# The script reads it with the plugin's client, and refuses any other host.
# With --mock: the mock's address, http://127.0.0.1:<port> (the store's
# PRINT_TRAIL_BASE_URL); the script starts the mock there itself.
PT_STAGING_BASE_URL=https://printtrail-core.consilstaging.com
PT_STAGING_CHANNEL_ID=
PT_STAGING_API_TOKEN=
# --mock only: the store's PRINT_TRAIL_WEBHOOK_SECRET (default mock-secret).
# CHECKLIST_MOCK_WEBHOOK_SECRET=

# Print Trail SKUs the staging channel can order. Each must resolve (variant
# SKU or print_trail_sku metadata) to a variant whose product is in a Print
# Trail shipping profile.
PT_STOCKED_SKU=
# From another supplier location, for the two-parcel scenario (else skipped).
PT_SECOND_SKU=
# Pre-order products (Print Trail API 1.3.0; skipped before that).
PT_PREORDER_SKU=
PT_PREORDER_LIMITED_SKU=

# Where the customer emails go: {run} becomes the run id. The default is
# checklist+{run}@example.com, which no one receives.
# CHECKLIST_CUSTOMER_EMAIL=you+{run}@example.org
# Shown when asking whether the cancel-too-late email reached the admin inbox
# (the store's PRINT_TRAIL_ADMIN_EMAIL), for example "mailpit on staging".
# CHECKLIST_ADMIN_INBOX=

# Optional.
# CHECKLIST_REGION_ID=
# CHECKLIST_COUNTRY=gb
# CHECKLIST_RUN_ID=
# Timeouts in seconds: send 90, webhook 180 (30 with --mock), human 900,
# sweep 420, crash 1500 (staging: a send cut off by the restart is retried
# after the plugin's 15-minute retry delay, by the next sweep).
# CHECKLIST_SEND_TIMEOUT=
# CHECKLIST_WEBHOOK_TIMEOUT=
# CHECKLIST_HUMAN_TIMEOUT=
# CHECKLIST_SWEEP_TIMEOUT=
# CHECKLIST_CRASH_TIMEOUT=
