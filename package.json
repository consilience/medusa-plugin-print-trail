{
  "name": "medusa-plugin-print-trail",
  "version": "0.2.0",
  "description": "Print Trail fulfilment for Medusa v2: orders sent automatically, stock levels synced and tracking sent back to Medusa.",
  "author": "Consilience Media Limited",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://printtrail.com/integrations/",
  "bugs": {
    "url": "https://printtrail.com/contact/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consilience/medusa-plugin-print-trail.git"
  },
  "files": [
    ".medusa/server",
    "!.medusa/server/**/__tests__",
    "!.medusa/server/dev",
    "!.medusa/server/integration-tests",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/printTrail": "./.medusa/server/src/modules/printTrail/index.js",
    "./config": {
      "types": "./.medusa/server/src/config.d.ts",
      "default": "./.medusa/server/src/config.js"
    },
    "./workflows": {
      "types": "./.medusa/server/src/workflows/index.d.ts",
      "default": "./.medusa/server/src/workflows/index.js"
    },
    "./modules/printTrail": {
      "types": "./.medusa/server/src/modules/printTrail/index.d.ts",
      "default": "./.medusa/server/src/modules/printTrail/index.js"
    },
    "./providers/print-trail": {
      "types": "./.medusa/server/src/providers/print-trail/index.d.ts",
      "default": "./.medusa/server/src/providers/print-trail/index.js"
    },
    "./stock": {
      "types": "./.medusa/server/src/stock.d.ts",
      "default": "./.medusa/server/src/stock.js"
    },
    "./shipping-options": {
      "types": "./.medusa/server/src/shipping-options.d.ts",
      "default": "./.medusa/server/src/shipping-options.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-shipping",
    "print-trail"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json && tsc -p scripts/staging-checklist/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "prepublishOnly": "medusa plugin:build",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http": "npm run build && TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:staging": "TEST_TYPE=staging NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "checklist:staging": "jiti scripts/staging-checklist/run.ts",
    "mock": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON dev/mock-print-trail.ts"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/eslint-plugin": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/icons": "2.22.1",
    "@medusajs/js-sdk": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/test-utils": "2.22.1",
    "@medusajs/ui": "4.2.8",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.17.2",
    "@medusajs/framework": "^2.17.2",
    "@medusajs/icons": "^2.17.2",
    "@medusajs/js-sdk": "^2.17.2",
    "@medusajs/medusa": "^2.17.2",
    "@medusajs/ui": "^4.1.19",
    "@tanstack/react-query": "^5.64.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8"
}
